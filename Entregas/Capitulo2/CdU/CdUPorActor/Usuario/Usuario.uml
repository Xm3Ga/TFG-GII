@startuml
left to right direction

actor "Usuario" as USR

rectangle "Misiones de Seguridad" {

    rectangle "Soporte" {
        usecase "Conectar proveedor cloud" as CdU01
        usecase "Descubrir agentes" as CdU02
    }

    rectangle "Guardarrailes" {
        usecase "Configurar guardarrail\nde contenido" as CdU03
        usecase "Configurar proteccion\nanti-jailbreak" as CdU04
        usecase "Configurar deteccion\nde PII" as CdU05
        usecase "Configurar controles\nadicionales" as CdU06
        usecase "Aplicar guardarrail\na agentes" as CdU07
    }

    rectangle "Minimo Privilegio" {
        usecase "Analizar privilegios\nde agentes" as CdU08
        usecase "Aplicar reduccion\nde privilegios" as CdU09
    }

    rectangle "Autonomia" {
        usecase "Clasificar autonomia\nde agentes" as CdU10
        usecase "Revisar validaciones\nhumanas propuestas" as CdU11
    }
}

USR -- CdU01
USR -- CdU02
USR -- CdU03
USR -- CdU04
USR -- CdU05
USR -- CdU06
USR -- CdU07
USR -- CdU08
USR -- CdU09
USR -- CdU10
USR -- CdU11

@enduml
