@startuml
left to right direction

[*] --> SIN_CONEXION

SIN_CONEXION --> PROVEEDOR_CONECTADO : conectarProveedorCloud()
PROVEEDOR_CONECTADO --> AGENTES_DESCUBIERTOS : descubrirAgentes()

AGENTES_DESCUBIERTOS --> MISION_GUARDARRAIL : iniciarMisionGuardarrail()
AGENTES_DESCUBIERTOS --> MISION_PRIVILEGIO : iniciarMisionMinimoPrivilegio()
AGENTES_DESCUBIERTOS --> MISION_AUTONOMIA : iniciarMisionAutonomia()

state MISION_GUARDARRAIL {
    [*] --> CREDENCIAL_GR
    CREDENCIAL_GR : Seleccionar credencial
    CREDENCIAL_GR --> PERMISOS_GR : verificarPermisos()
    PERMISOS_GR : Verificar permisos cloud
    PERMISOS_GR --> CONFIGURACION_GR : configurarControl()
    CONFIGURACION_GR : Configurar guardarrail\no security setting
    CONFIGURACION_GR --> APLICACION_GR : aplicarAAgentes()
    APLICACION_GR : Aplicar y registrar\nresultado por agente
    APLICACION_GR --> [*]
}

state MISION_PRIVILEGIO {
    [*] --> CREDENCIAL_MP
    CREDENCIAL_MP : Seleccionar credencial
    CREDENCIAL_MP --> PREFLIGHT_MP : preflight()
    PREFLIGHT_MP : Resolver identidad runtime
    PREFLIGHT_MP --> BASELINE_MP : generarBaseline()
    BASELINE_MP : Permisos actuales,\npropuestos y removibles
    BASELINE_MP --> REVISION_MP : revisarBaseline()
    REVISION_MP : Aprobacion o dry-run
    REVISION_MP --> APLICACION_MP : aplicarCambios()
    APLICACION_MP : Guardar apply run\ny rollback snapshot
    APLICACION_MP --> [*]
}

state MISION_AUTONOMIA {
    [*] --> ALCANCE_MA
    ALCANCE_MA : Seleccionar alcance
    ALCANCE_MA --> ESCANEO_MA : analizarMetadatos()
    ESCANEO_MA : Detectar senales de riesgo
    ESCANEO_MA --> PERFIL_MA : guardarPerfil()
    PERFIL_MA : Nivel, confianza,\nevidencias
    PERFIL_MA --> VALIDACIONES_MA : proponerValidaciones()
    VALIDACIONES_MA : Checkpoints HITL\nsin enforcement runtime
    VALIDACIONES_MA --> [*]
}

MISION_GUARDARRAIL --> AGENTES_DESCUBIERTOS : completarMision()
MISION_PRIVILEGIO --> AGENTES_DESCUBIERTOS : completarMision()
MISION_AUTONOMIA --> AGENTES_DESCUBIERTOS : completarMision()

@enduml
