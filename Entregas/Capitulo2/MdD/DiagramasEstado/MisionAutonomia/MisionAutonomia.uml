@startuml

[*] --> INICIADA

INICIADA --> CREDENCIAL_SELECCIONADA : seleccionarCredencial()
CREDENCIAL_SELECCIONADA --> PERMISOS_VERIFICADOS : verificarPermisos()
CREDENCIAL_SELECCIONADA --> ERROR_PERMISOS : permisosInsuficientes()
ERROR_PERMISOS --> CREDENCIAL_SELECCIONADA : corregirPermisos()

PERMISOS_VERIFICADOS --> AGENTES_LISTADOS : listarAgentes()

AGENTES_LISTADOS --> CAPACIDADES_ANALIZADAS : analizarCapacidades()
CAPACIDADES_ANALIZADAS --> RIESGO_EVALUADO : evaluarRiesgo()

RIESGO_EVALUADO --> NIVELES_PROPUESTOS : proponerNivelesAutonomia()
RIESGO_EVALUADO --> RIESGO_AJUSTADO : ajustarClasificacion()
RIESGO_AJUSTADO --> NIVELES_PROPUESTOS : reproponerNiveles()

NIVELES_PROPUESTOS --> NIVELES_ASIGNADOS : confirmarNiveles()

NIVELES_ASIGNADOS --> CONFIGURANDO_SUPERVISION : configurarHITL()
NIVELES_ASIGNADOS --> COMPLETADA : sinAgentesSupervisados()

CONFIGURANDO_SUPERVISION --> REGLAS_DEFINIDAS : definirReglasSupervision()
REGLAS_DEFINIDAS --> APROBADORES_ASIGNADOS : asignarAprobadores()
APROBADORES_ASIGNADOS --> TIMEOUT_CONFIGURADO : configurarTimeout()
TIMEOUT_CONFIGURADO --> SUPERVISION_ACTIVA : activarSupervision()

SUPERVISION_ACTIVA --> COMPLETADA : confirmarConfiguracion()

INICIADA --> CANCELADA : cancelarMision()
AGENTES_LISTADOS --> CANCELADA : cancelarMision()
NIVELES_PROPUESTOS --> CANCELADA : cancelarMision()

COMPLETADA --> [*]
CANCELADA --> [*]

@enduml
