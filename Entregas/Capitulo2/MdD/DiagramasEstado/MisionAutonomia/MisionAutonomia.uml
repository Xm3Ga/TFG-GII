@startuml

[*] --> INICIADA

INICIADA --> ALCANCE_SELECCIONADO : seleccionarAlcance()
ALCANCE_SELECCIONADO --> ESCANEO_EN_CURSO : runAutonomyScan()

ESCANEO_EN_CURSO --> PERFILES_GENERADOS : guardarProfiles()
ESCANEO_EN_CURSO --> SIN_DATOS : metadatosInsuficientes()

SIN_DATOS --> PERFILES_GENERADOS : marcarUnknown()

PERFILES_GENERADOS --> VALIDACIONES_PROPUESTAS : generarProposedValidations()
VALIDACIONES_PROPUESTAS --> REVISION_USUARIO : mostrarEnSecurity()
REVISION_USUARIO --> COMPLETADA : revisarEvidencia()

note right of VALIDACIONES_PROPUESTAS
No activa enforcement runtime.
Solo propone checkpoints humanos.
end note

COMPLETADA --> [*]

@enduml
