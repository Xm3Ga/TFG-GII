@startuml

[*] --> INICIADA

INICIADA --> CREDENCIAL_SELECCIONADA : seleccionarCredencial()
CREDENCIAL_SELECCIONADA --> PREFLIGHT : preflight()
PREFLIGHT --> PRINCIPALES_RESUELTOS : identidadesRuntimeOk()
PREFLIGHT --> BLOQUEADA : identidadOPermisosInsuficientes()

BLOQUEADA --> CREDENCIAL_SELECCIONADA : corregirEntrada()

PRINCIPALES_RESUELTOS --> SCAN_EN_CURSO : ejecutarScan()
SCAN_EN_CURSO --> BASELINES_GENERADAS : guardarBaselines()
SCAN_EN_CURSO --> FALLIDA : errorProveedor()

BASELINES_GENERADAS --> REVISION_USUARIO : revisarBaseline()
REVISION_USUARIO --> DRY_RUN : aplicarSinCambios()
REVISION_USUARIO --> APLICACION_REAL : aplicarConAprobacion()
REVISION_USUARIO --> COMPLETADA : noAplicar()

DRY_RUN --> COMPLETADA : registrarResultado()
APLICACION_REAL --> APLICADA : proveedorActualizado()
APLICACION_REAL --> FALLIDA : errorAplicacion()

APLICADA --> ROLLBACK_EN_CURSO : solicitarRollback()
ROLLBACK_EN_CURSO --> REVERTIDA : restaurarSnapshot()
ROLLBACK_EN_CURSO --> FALLIDA : errorRollback()

APLICADA --> COMPLETADA : confirmarResultado()
REVERTIDA --> COMPLETADA : confirmarResultado()

COMPLETADA --> [*]
FALLIDA --> [*]

@enduml
