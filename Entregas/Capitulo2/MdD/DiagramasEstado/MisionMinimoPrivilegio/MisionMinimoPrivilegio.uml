@startuml

[*] --> INICIADA

INICIADA --> CREDENCIAL_SELECCIONADA : seleccionarCredencial()
CREDENCIAL_SELECCIONADA --> PERMISOS_VERIFICADOS : verificarPermisos()
CREDENCIAL_SELECCIONADA --> ERROR_PERMISOS : permisosInsuficientes()
ERROR_PERMISOS --> CREDENCIAL_SELECCIONADA : corregirPermisos()

PERMISOS_VERIFICADOS --> AGENTES_SELECCIONADOS : seleccionarAgentes()
AGENTES_SELECCIONADOS --> EN_ANALISIS : iniciarAnalisis()

EN_ANALISIS --> RECOPILANDO_DATOS : recopilarHistorialUso()
RECOPILANDO_DATOS --> COMPARANDO_PERMISOS : compararPermisosVsUso()
COMPARANDO_PERMISOS --> ANALISIS_COMPLETADO : generarRecomendaciones()

EN_ANALISIS --> DATOS_INSUFICIENTES : datosInsuficientes()
DATOS_INSUFICIENTES --> AGENTES_SELECCIONADOS : ajustarPeriodo()
DATOS_INSUFICIENTES --> COMPLETADA : aceptarObservacion()

ANALISIS_COMPLETADO --> RECOMENDACIONES_REVISADAS : revisarRecomendaciones()
RECOMENDACIONES_REVISADAS --> REDUCCION_EN_CURSO : aplicarReduccion()
RECOMENDACIONES_REVISADAS --> COMPLETADA : rechazarTodas()

REDUCCION_EN_CURSO --> VERIFICANDO_FUNCIONAMIENTO : verificarAgentes()
VERIFICANDO_FUNCIONAMIENTO --> COMPLETADA : confirmarResultados()
VERIFICANDO_FUNCIONAMIENTO --> REVERTIENDO : errorEnAgente()
REVERTIENDO --> ANALISIS_COMPLETADO : restaurarPermisos()

INICIADA --> CANCELADA : cancelarMision()
AGENTES_SELECCIONADOS --> CANCELADA : cancelarMision()
ANALISIS_COMPLETADO --> CANCELADA : cancelarMision()

COMPLETADA --> [*]
CANCELADA --> [*]

@enduml
