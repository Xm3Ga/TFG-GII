@startuml

skinparam rectangleBorderColor #333
skinparam rectangleBackgroundColor #FAFAFA

rectangle Organizacion
rectangle Usuario
rectangle ProveedorCloud
rectangle Credencial
rectangle AgenteIA
rectangle Mision
rectangle MisionDeGuardarrail
rectangle MisionDeMinimoPrivilegio
rectangle MisionDeAutonomia
rectangle Guardarrail
rectangle SecuritySetting
rectangle PoliticaGuardarrail
rectangle IdentidadRuntime
rectangle BaselinePrivilegios
rectangle EjecucionAplicacionPrivilegios
rectangle EventoPrivilegios
rectangle PerfilAutonomiaAgente
rectangle CategoriaRiesgoAutonomia
rectangle ValidacionHumanaPropuesta
rectangle CAIO
rectangle RegistroDeAuditoria

Organizacion "1" o-- "*" Usuario : pertenece a
Organizacion "1" o-- "*" Credencial : posee
Organizacion "1" o-- "*" AgenteIA : inventaria

Credencial "*" -- "1" ProveedorCloud : conecta con
AgenteIA "*" -- "1" ProveedorCloud : desplegado en

' === Guardarrailes ===
MisionDeGuardarrail "*" -- "*" PoliticaGuardarrail : configura
PoliticaGuardarrail "*" -- "0..1" Guardarrail : AWS Bedrock
PoliticaGuardarrail "*" -- "0..1" SecuritySetting : GCP Dialogflow CX
AgenteIA "*" -- "*" Guardarrail : protegido por
AgenteIA "*" -- "*" SecuritySetting : protegido por

' === Minimo Privilegio ===
AgenteIA "1" -- "0..1" IdentidadRuntime : opera como
MisionDeMinimoPrivilegio "1" -- "*" BaselinePrivilegios : genera
BaselinePrivilegios "*" -- "1" AgenteIA : analiza
BaselinePrivilegios "*" -- "1" IdentidadRuntime : propone permisos para
BaselinePrivilegios "1" -- "*" EjecucionAplicacionPrivilegios : aplica/rollback
EjecucionAplicacionPrivilegios "1" -- "*" EventoPrivilegios : registra

' === Autonomia ===
MisionDeAutonomia "1" -- "*" PerfilAutonomiaAgente : genera
PerfilAutonomiaAgente "*" -- "1" AgenteIA : clasifica
PerfilAutonomiaAgente "*" -- "*" CategoriaRiesgoAutonomia : detecta
PerfilAutonomiaAgente "1" -- "*" ValidacionHumanaPropuesta : propone

' === Misiones ===
Mision <|-- MisionDeGuardarrail
Mision <|-- MisionDeMinimoPrivilegio
Mision <|-- MisionDeAutonomia

Mision "*" -- "1" Organizacion : pertenece a
Mision "*" -- "1" Credencial : utiliza

CAIO "1" -- "*" Mision : guia
Mision "1" -- "*" RegistroDeAuditoria : genera

@enduml
