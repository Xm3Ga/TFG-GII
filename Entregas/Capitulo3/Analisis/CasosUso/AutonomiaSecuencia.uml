@startuml
actor Usuario
participant "VistaMisionConversacional" as Vista
participant "SecurityRouter" as SecurityAPI
participant "SecurityScanService" as ScanService
participant "AgentRepository" as AgentRepo
participant "LLMService" as LLM
participant "RepositorioPoliticasAutonomia" as PolicyRepo
participant "AuditLog" as Audit

Usuario -> Vista : inicia mision de autonomia
Vista -> SecurityAPI : GET /security/status
SecurityAPI -> ScanService : get_status()
ScanService -> AgentRepo : obtener agentes
AgentRepo --> ScanService : inventario
ScanService --> Vista : estado de riesgo

Usuario -> Vista : solicita evaluacion
Vista -> SecurityAPI : POST /security/scan
SecurityAPI -> ScanService : scan_all()
loop por cada agente
  ScanService -> AgentRepo : cargar agente
  ScanService -> LLM : analizar capacidades y riesgo
  LLM --> ScanService : hallazgos y recomendaciones
end
ScanService --> SecurityAPI : resultados
SecurityAPI -> Audit : security_scan_completed
SecurityAPI --> Vista : riesgos por agente

Usuario -> Vista : acepta niveles propuestos
Vista -> PolicyRepo : guardar politica de autonomia
PolicyRepo --> Vista : politica activa
Vista -> Audit : autonomia_configurada
Vista --> Usuario : resumen de supervisiones

@enduml
