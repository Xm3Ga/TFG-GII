@startuml
left to right direction

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

class "Usuario" as Usuario <<actor>>

package "Vista" {
  class "VistaCredenciales" as Vista
}

package "Controlador" {
  class "ControladorCredenciales" as Controlador
}

package "Modelo" {
  class "Credencial" as Credencial
  class "ProveedorCloud" as Proveedor
}

class "API proveedor cloud" as ApiProveedor <<externo>>

Usuario --> Vista : introduce credenciales
Vista --> Controlador : solicita conexion
Controlador --> ApiProveedor : verifica conexion
Controlador --> Credencial : guarda credencial cifrada
Credencial --> Proveedor : pertenece a
ApiProveedor --> Proveedor : representa

@enduml
