@startuml
left to right direction

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

class "Usuario" as Usuario <<actor>>

package "Vista" {
  class "VistaAntiJailbreak" as Vista
}

package "Controlador" {
  class "ControladorGuardarrailes" as Controlador
}

package "Modelo" {
  class "Guardarrail" as Guardarrail
  class "AgenteIA" as Agente
}

class "API proveedor cloud" as ApiProveedor <<externo>>

Usuario --> Vista : configura proteccion
Vista --> Controlador : solicita guardarrail
Controlador --> ApiProveedor : crea o actualiza
Controlador --> Guardarrail : registra configuracion
Controlador --> Agente : aplica proteccion
Guardarrail --> Agente : protege

@enduml
