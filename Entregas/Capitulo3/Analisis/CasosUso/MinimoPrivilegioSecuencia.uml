@startuml
actor Usuario
participant "VistaMisionConversacional" as Vista
participant "LeastPrivilegeRouter" as Router
participant "LeastPrivilegeService" as Service
participant "ProviderAdapter" as Adapter
participant "LeastPrivilegeRepository" as Repo

Usuario -> Vista : inicia mision de minimo privilegio
Vista -> Router : POST /least-privilege/preflight
Router -> Service : preflight(credencial, agentes)
Service -> Adapter : resolver identidades runtime
Adapter --> Service : principales / errores
Service --> Router : diagnostico
Router --> Vista : resultado preflight

Usuario -> Vista : solicita scan
Vista -> Router : POST /least-privilege/scans
Router -> Service : run_scan()
loop por agente
  Service -> Adapter : obtener permisos y evidencia
  Adapter --> Service : permisos actuales / observados
  Service -> Repo : guardar LeastPrivilegeBaseline
end
Service --> Router : baselines generadas
Router --> Vista : propuestas revisables

Usuario -> Vista : aprueba baseline
Vista -> Router : POST /least-privilege/baselines/{id}/apply
Router -> Service : apply_baseline()
Service -> Repo : crear lock y apply run
Service -> Adapter : aplicar permisos propuestos
Adapter --> Service : resultado y rollback snapshot
Service -> Repo : guardar eventos
Service --> Router : resultado
Router --> Vista : aplicado / fallido

@enduml
