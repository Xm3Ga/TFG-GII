@startuml
skinparam classAttributeIconSize 0

package "API" {
  class CredentialsRouter
  class AgentsRouter
  class MissionsRouter
  class LeastPrivilegeRouter
  class AutonomyRouter
  class SecurityRouter
  class AuditLogsRouter
  class CAIORouter
}

package "Servicios" {
  class SyncService {
    +sync_provider()
    +sync_all()
  }
  class LeastPrivilegeService {
    +preflight()
    +run_scan()
    +apply_baseline()
    +rollback_apply_run()
  }
  class AutonomyService {
    +run_scan()
    +classify_agent()
  }
  class LLMService
  class KnowledgeAssemblyService
}

package "Repositorios" {
  class CredentialRepository
  class AgentRepository
  class AuditLogRepository
  class LeastPrivilegeRepository
  class AutonomyRepository
}

package "Conectores" {
  abstract class BaseConnector {
    +test_connection()
    +list_agents()
  }
  class ConnectorFactory {
    +create()
  }
  class AWSConnector
  class AzureConnector
  class GCPConnector
}

package "Modelos ORM" {
  class Organization
  class User
  class Credential
  class Agent
  class AuditLog
  class LeastPrivilegeScan
  class LeastPrivilegeBaseline
  class LeastPrivilegeApplyRun
  class LeastPrivilegeEvent
  class LeastPrivilegeLock
  class AutonomyScanRun
  class AgentAutonomyProfile
}

CredentialsRouter --> CredentialRepository
CredentialsRouter --> ConnectorFactory
AgentsRouter --> AgentRepository
AgentsRouter --> SyncService

MissionsRouter --> CredentialRepository
MissionsRouter --> AWSConnector
MissionsRouter --> GCPConnector
MissionsRouter --> AuditLogRepository

LeastPrivilegeRouter --> LeastPrivilegeService
AutonomyRouter --> AutonomyService
SecurityRouter --> LeastPrivilegeRepository
SecurityRouter --> AutonomyRepository
AuditLogsRouter --> AuditLogRepository
CAIORouter --> KnowledgeAssemblyService
CAIORouter --> LLMService

SyncService --> CredentialRepository
SyncService --> AgentRepository
SyncService --> ConnectorFactory

LeastPrivilegeService --> LeastPrivilegeRepository
LeastPrivilegeService --> AgentRepository
LeastPrivilegeService --> ConnectorFactory

AutonomyService --> AutonomyRepository
AutonomyService --> AgentRepository

ConnectorFactory --> BaseConnector
BaseConnector <|-- AWSConnector
BaseConnector <|-- AzureConnector
BaseConnector <|-- GCPConnector

Organization "1" o-- "*" User
Organization "1" o-- "*" Credential
Organization "1" o-- "*" Agent
Organization "1" o-- "*" AuditLog
Organization "1" o-- "*" LeastPrivilegeScan
Organization "1" o-- "*" AutonomyScanRun
Agent "1" o-- "*" LeastPrivilegeBaseline
Agent "1" o-- "0..1" AgentAutonomyProfile
LeastPrivilegeScan "1" o-- "*" LeastPrivilegeBaseline
LeastPrivilegeBaseline "1" o-- "*" LeastPrivilegeApplyRun
AutonomyScanRun "1" o-- "*" AgentAutonomyProfile

@enduml
