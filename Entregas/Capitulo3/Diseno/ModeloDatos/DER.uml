@startuml
hide circle
skinparam linetype ortho

entity organizations {
  * id : uuid
  --
  name : string
  security_enabled : boolean
}

entity users {
  * id : uuid
  --
  organization_id : uuid
  email : string
  name : string
  role : string
}

entity credentials {
  * id : uuid
  --
  organization_id : uuid
  name : string
  provider : string
  encrypted_data : text
  region : string
  is_valid : boolean
}

entity agents {
  * id : uuid
  --
  organization_id : uuid
  provider : string
  provider_id : string
  name : string
  type : string
  status : string
  region : string
  role_arn : string
  raw_data : json
}

entity audit_logs {
  * id : uuid
  --
  organization_id : uuid
  action : string
  resource_type : string
  resource_id : uuid
  provider : string
  details : json
  created_at : datetime
}

entity least_privilege_scans {
  * id : uuid
  --
  organization_id : uuid
  credential_id : uuid
  provider : string
  status : string
  agent_count : integer
  created_by_user_id : uuid
}

entity least_privilege_baselines {
  * id : uuid
  --
  organization_id : uuid
  scan_id : uuid
  agent_id : uuid
  provider : string
  principal_id : string
  status : string
  confidence : string
  current_permissions : json
  proposed_permissions : json
  removable_permissions : json
  evidence_json : json
}

entity least_privilege_apply_runs {
  * id : uuid
  --
  organization_id : uuid
  baseline_id : uuid
  credential_id : uuid
  status : string
  dry_run : boolean
  approved_by_user_id : uuid
  rollback_snapshot_json : json
}

entity least_privilege_events {
  * id : uuid
  --
  organization_id : uuid
  scan_id : uuid
  baseline_id : uuid
  apply_run_id : uuid
  event_type : string
  details_json : json
}

entity least_privilege_locks {
  * id : uuid
  --
  organization_id : uuid
  provider : string
  principal_id : string
  expires_at : datetime
}

entity autonomy_scan_runs {
  * id : uuid
  --
  organization_id : uuid
  status : string
  provider_filter : string
  agent_count : integer
  high_risk_count : integer
  unknown_count : integer
}

entity agent_autonomy_profiles {
  * id : uuid
  --
  organization_id : uuid
  scan_id : uuid
  agent_id : uuid
  autonomy_level : string
  confidence : string
  risk_categories : json
  evidence_json : json
  proposed_validations : json
}

entity security_scan_results {
  * id : uuid
  --
  organization_id : uuid
  agent_id : uuid
  overall_risk : string
  findings : text
  recommendations : text
}

organizations ||--o{ users
organizations ||--o{ credentials
organizations ||--o{ agents
organizations ||--o{ audit_logs
organizations ||--o{ least_privilege_scans
organizations ||--o{ least_privilege_baselines
organizations ||--o{ least_privilege_apply_runs
organizations ||--o{ least_privilege_events
organizations ||--o{ least_privilege_locks
organizations ||--o{ autonomy_scan_runs
organizations ||--o{ agent_autonomy_profiles
organizations ||--o{ security_scan_results

credentials ||--o{ least_privilege_scans
credentials ||--o{ least_privilege_apply_runs
least_privilege_scans ||--o{ least_privilege_baselines
least_privilege_scans ||--o{ least_privilege_events
least_privilege_baselines ||--o{ least_privilege_apply_runs
least_privilege_baselines ||--o{ least_privilege_events
least_privilege_apply_runs ||--o{ least_privilege_events
agents ||--o{ least_privilege_baselines
agents ||--o{ agent_autonomy_profiles
agents ||--o{ security_scan_results
autonomy_scan_runs ||--o{ agent_autonomy_profiles

@enduml
